---
---
[
  {% for doc in site.docs %}
  {
    "title": {{ doc.title | jsonify }},
    "url": {{ doc.url | prepend: site.baseurl | jsonify }},
    "description": {{ doc.description | default: doc.content | strip_html | truncatewords: 25 | jsonify }},
    "categories": {{ doc.categories | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
